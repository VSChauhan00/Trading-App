REACT_APP_API_PORT=3002
PORT=3001
# Frontend landing page URL — used for redirect on auth failure / logout
REACT_APP_FRONTEND_URL=http://localhost:3000

# Prevent the dashboard dev-server from auto-opening a browser tab.
# The dashboard is reached only via the frontend login redirect, so only
# the frontend should open automatically when `npm run dev` starts.
BROWSER=none
