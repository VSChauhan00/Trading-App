# === Backend API Configuration ===
# Backend port (default: 3002) - used to construct http://localhost:PORT
REACT_APP_API_PORT=3002
# Optional: override the full backend URL (useful for deployment)
# REACT_APP_API_URL=http://localhost:3002

# === Frontend (Landing Page) Configuration ===
# Port for the landing page (default: 3000)
# PORT=3000

# === Dashboard Configuration ===
# URL to redirect to after successful signup/login
# (dashboard is a separate React app on its own port)
REACT_APP_DASHBOARD_URL=http://localhost:3001
